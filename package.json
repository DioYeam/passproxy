{
  "name": "passproxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that decompresses gzip request bodies and streams upstream LLM responses.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:upstream": "node scripts/local-upstream.mjs",
    "deploy": "wrangler deploy --keep-vars",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:chunks": "node scripts/chunked-client.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "undici": "^7.30.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
