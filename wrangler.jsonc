{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridge-snap",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "MAX_DECOMPRESSED_BYTES": "2097152",
    "UPSTREAM_TIMEOUT_MS": "600000"
  }
}
